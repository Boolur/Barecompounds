# Public Supabase project settings. The app uses local catalog fallbacks when
# these values are omitted.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-public-anon-key

# Server-only Vercel settings. Never prefix these with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token
RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SENTRY_DSN=https://public-key@your-org.ingest.sentry.io/project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=https://public-key@your-org.ingest.sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=replace-with-your-sentry-org
SENTRY_PROJECT=replace-with-your-sentry-project
SENTRY_AUTH_TOKEN=replace-with-your-sentry-build-token

# The Resend values belong in Supabase Edge Function secrets, not Vercel:
# RESEND_API_KEY, RESEND_FROM_EMAIL

# Optional: run browser tests against an already-running deployment.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
